# Copy to deploy/azure/.env.production (ignored by git and by Docker) and fill in.
# One KEY=VALUE per line, no quotes. The deploy script stores the sensitive ones
# as Container Apps secrets.

# Required
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nexo?appName=Cluster0
SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
ADMIN_API_KEY=generate-with-openssl-rand-base64-32

# Only the official app (Firebase App Check). Without a project number,
# enforce mode refuses every request.
APP_CHECK_MODE=enforce
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=

# Personal data: DNIs or SIGMA codes, comma separated.
AUTHORIZED_TEACHERS=
SYSTEM_ADMINS=

# Optional
# SIGMA_BASE_URL=https://sigma.upla.edu.pe/api
